# ── Required: at least one LLM provider key ─────────────────────────────────

# Recommended: OpenRouter (access to all models via one key)
OPENROUTER_API_KEY=sk-or-...

# Or: direct OpenAI
# OPENAI_API_KEY=sk-...

# Or: direct Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Choose the active provider/model in the Hermes dashboard. The selection is
# stored in ~/.hermes/config.yaml; model routing is intentionally not duplicated
# in this environment file.

# ── Optional: Tool APIs ──────────────────────────────────────────────────────

# Web search (pick one or more)
EXA_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=

# Image generation
FAL_KEY=

# Cross-session user modeling
HONCHO_API_KEY=

# GitHub (higher rate limits for code tools)
GITHUB_TOKEN=

# ── Optional: Browser automation ─────────────────────────────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Gateway security ──────────────────────────────────────────────────────────
# Set to false and configure allowlists if you want to restrict access
GATEWAY_ALLOW_ALL_USERS=true

# ── Terminal backend ──────────────────────────────────────────────────────────
# Options: local, docker, modal, ssh
TERMINAL_ENV=local
TERMINAL_TIMEOUT=60
